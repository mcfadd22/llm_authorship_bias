# OS
.DS_Store

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/

# Data (raw/intermediate outputs — keep out of git; add exceptions as needed)
data/*
!data/.gitkeep
!data/items/
!data/items/**
!data/items.csv
!data/items_clean/
!data/items_clean/**
!data/elicitation/
!data/elicitation/*.jsonl
# Wave 2 and any alternate-generator item bank: data/* above would otherwise
# swallow these, leaving a paid-for run tracked nowhere.
!data/elicitation_wave2/
!data/elicitation_wave2/**/
!data/elicitation_wave2/**/*.jsonl
!data/items_*/
!data/items_*/**

# Environment / secrets
.env

# Run logs stay out of git regardless of the data/ exceptions above.
data/elicitation/logs/
data/**/logs/

# Analysis outputs (regenerate with analysis/*.py)
analysis/*.csv
analysis/item_review.html
# ...but hand-entered item verdicts are input data, not regenerable output.
!analysis/item_verdicts*.csv
